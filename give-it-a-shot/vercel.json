{
  "rewrites": [
    { "source": "/teachers", "destination": "/index.html" },
    { "source": "/teacher", "destination": "/index.html" },
    { "source": "/teacher/:path*", "destination": "/index.html" },
    { "source": "/classroom", "destination": "/index.html" },
    { "source": "/classroom/:path*", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/teacher/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }, { "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/teacher", "headers": [{ "key": "Cache-Control", "value": "no-store" }, { "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/classroom/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/classroom", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
